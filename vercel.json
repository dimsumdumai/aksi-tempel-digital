{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "runtime": "@vercel/node@3",
      "maxDuration": 30
    },
    "api/hello.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    {"source": "/((?!api/).*)", "destination": "/index.html"}
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}
      ]
    }
  ]
}
